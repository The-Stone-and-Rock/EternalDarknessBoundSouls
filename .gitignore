# Your disc image and everything translated from it stay on your machine.
dump/
# Character portraits, written from the disc by the menu.
res/ui/portraits/
# The launcher's music, converted from the disc (tools/launcher_music.py).
res/music/
# The title menu's video folder: the Options picture there is taken from the disc as the game runs (options.rgba).
res/video/*
# The title video itself is the project's own (an AI-made video, no game asset): it ships.
!res/video/title.mpg
# Your own video to convert from.
Background video/
generated/
build*/
.deps/
*.dolcard
*-sram.bin
__pycache__/
# Player settings and save slots (written by the launcher).
settings.ini
saves/
logs/
# Pictures taken of the game while testing.
Screenshots for Claude/
# HD texture packs you add (Dolphin format, tex1_*.png).
textures/
.DS_Store
.build-commit
