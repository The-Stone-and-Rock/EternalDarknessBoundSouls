+// What ED_INPUT_SCRIPT holds for a frame, with nothing logged or kept: for both_record, which runs before it is applied.
+static void input_script_peek(u64 frame, u16* buttons, s8* stick_x, s8* stick_y) {
+    for (unsigned i = 0; i < g_input_script_count; ++i) {
+        const InputScriptEvent* event = &g_input_script[i];
+        if (frame < event->start_frame || frame >= event->end_frame)
+            continue;
+        *buttons |= event->buttons;
+        if (event->stick_x != 0)
+            *stick_x = event->stick_x;
+        if (event->stick_y != 0)
+            *stick_y = event->stick_y;
+    }
+}
