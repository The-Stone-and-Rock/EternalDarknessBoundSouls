/* RmlUi has no default style sheet: declare what the menu uses. */
div { display: block; }
span { display: inline; }

/* Every submenu, in the launcher and over the game: one sheet of the parchment
   (res/ui/pause.png), sized by the window's height, so it keeps its shape and
   everything on it fits at any window size. Behind it, the launcher's picture
   dimmed; over the game, the dimmed paused frame. */
body {
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	font-family: "IM FELL English";
	font-weight: normal;
	font-size: 3.2vh;
	color: #2a1810;
	background-color: #000000;
	decorator: image(launcher.png cover);
	image-color: #5c5c5c;
}

/* Over the game the page sits on the dimmed, paused frame. */
body.overlay {
	background-color: #000000b0;
	decorator: none;
}

#book {
	display: flex;
	flex-direction: column;
	width: 102.6vh;   /* the picture's own shape, 706 by 578 */
	height: 84vh;
	padding: 5.5vh 0 6.5vh 0;
	box-sizing: border-box;
	decorator: image(pause.png fill);
}

#heading {
	font-size: 5vh;
	text-align: center;
	flex-shrink: 0;
}

#pages {
	display: flex;
	flex: 1;
	min-height: 0;
}

.page {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding: 0 16vh;
}

.menu {
	display: flex;
	flex-direction: column;
	flex: 1;
	justify-content: center;
}

/* Button mapping: two columns on the one sheet. */
#page1 {
	display: none;
}

body.spread #page1 {
	display: flex;
}

body.spread .page {
	padding: 0 2vh 0 8vh;
}

body.spread #page1 {
	padding: 0 8vh 0 2vh;
}

body.spread .menu {
	justify-content: flex-start;
	margin-top: 1vh;
}

/* A small heading over a group of rows. */
.section {
	font-size: 2.4vh;
	color: #4a3018;
	padding: 0 1.4vh;
	margin: 1.4vh 0 0.3vh 0;
}

/* A break between groups of rows: only space. */
.gap {
	height: 1.8vh;
	flex-shrink: 0;
}

/* A row: the name at the left, its control at the right. Each has a frame of
   its own, shown round the chosen one. */
.row {
	display: flex;
	align-items: center;
	flex-shrink: 0;
	min-height: 3.3vh;
	padding: 0.1vh 1.2vh;
	border: 2dp transparent;
	border-radius: 8dp;
}

.leader {
	flex: 1;
	min-width: 2vh;
}

.value {
	display: flex;
	align-items: center;
	white-space: nowrap;
}

/* The longest pages (Controls, Button mapping): the same letters, smaller, so
   every row stays on the sheet. */
body.dense .row {
	font-size: 2.6vh;
}

/* Back, and the plain lists of actions (a save slot's page): centred. */
.row.back,
body.centered .row {
	justify-content: center;
}

.row.back {
	width: 40%;
	margin: 0 auto;
}

body.centered .row {
	width: 60%;
	margin: 0 auto;
}

body.centered .row .leader {
	flex: 0;
	min-width: 1.2vh;
	width: 1.2vh;
}

/* A choice among several: arrows round it, the value in the middle so it stays
   put as it changes. */
.chev {
	display: block;
	width: 2.6vh;
	height: 2.6vh;
	line-height: 2.2vh;
	font-size: 3.6vh;
	text-align: center;
	color: #7a2012;
}

.pick {
	display: block;
	min-width: 16vh;
	text-align: center;
}

/* On or off. Red ink with the knob to the right, or a hollow outline. */
.switch {
	display: block;
	width: 4.8vh;
	height: 2.4vh;
	box-sizing: border-box;
	border: 2dp #5a3a20;
	border-radius: 1.2vh;
	background-color: #2a181018;
}

.switch.on {
	border-color: #6a140d;
	background-color: #8e1b12;
}

.knob {
	display: block;
	width: 1.5vh;
	height: 1.5vh;
	margin: 0.25vh 0 0 0.25vh;
	border-radius: 0.75vh;
	background-color: #5a3a20;
}

.switch.on .knob {
	margin-left: 2.65vh;
	background-color: #f0e4c8;
}

/* A level from none to all (the volumes). */
.slider {
	display: block;
	width: 15vh;
	height: 1vh;
	box-sizing: border-box;
	border: 1dp #5a3a20;
	border-radius: 0.5vh;
	background-color: #2a181018;
}

.slider-fill {
	display: block;
	height: 100%;
	border-radius: 0.5vh;
	background-color: #8e1b12;
}

.slider-value {
	display: block;
	width: 8vh;
	text-align: right;
}

/* The chosen row: the game's own glowing frame (its memory card screen's),
   the ink kept black. */
.row.selected {
	color: #1a0f08;
	border-color: #d4f0ff;
	background-color: #cfeeff40;
	box-shadow: #6ec4ff 0 0 22dp 6dp, #9fdcffd0 0 0 10dp 2dp inset;
}

.row.selected .value {
	color: #1a0f08;
}

.row.disabled,
.row.disabled .value {
	color: #7a6a52;
}

.row.selected.disabled {
	color: #6a5a4a;
}

.row.disabled .switch {
	border-color: #8a7a62;
	background-color: transparent;
}

.row.disabled .switch .knob {
	background-color: #8a7a62;
}

/* The chosen row's help, always the same height, so a longer text never moves
   the rows as the selection moves. */
.note {
	flex-shrink: 0;
	height: 5.6vh;
	overflow: hidden;
	margin: 1vh 12vh 0 12vh;
	font-size: 2.2vh;
	color: #4a3018;
	text-align: center;
}

#hint {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 2.2vh;
	font-size: 2.2vh;
	color: #d2bf98;
	text-align: center;
}

/* Button and key icons (Kenney Input Prompts, CC0) in their menu versions
   (res/ui/glyphs/ink: white keys with an ink rim, coloured buttons as they
   are), drawn straight on the parchment. */
img.glyph {
	width: 3.2vh;
	height: 3.2vh;
	margin-left: 0.4vh;
	vertical-align: middle;
}

.sep {
	display: inline-block;
	width: 1.8vh;
}

.keycap {
	display: inline-block;
	padding: 0.1vh 0.8vh;
	margin-left: 0.4vh;
	border: 1dp #5a3a20;
	border-radius: 4dp;
	font-size: 1.7vh;
	color: #2a1810;
	vertical-align: middle;
}

.unbound {
	color: #8a7a62;
}

/* Character select: every character at once, a frame for their portrait over
   their name, and beside them the highlighted character's details. */
body.roster #book {
	width: 150vh;
	max-width: 97vw;
	height: 95vh;
	margin-bottom: 3vh;
	padding: 5vh 0 5vh 0;
}

body.roster #heading {
	font-size: 6vh;
}

body.roster .page {
	padding: 0 10vh;
}

body.roster .note {
	display: none;
}

.roster-wrap {
	display: flex;
	align-items: flex-start;
}

/* The frames, three lines in view; the rest come a line at a time (frontend.cpp roster_keep_in_view), with
   a bar beside them showing where the view is. The details panel beside them stays. */
.roster-scroll {
	display: flex;
	flex-shrink: 0;
	height: 56vh;
}

.roster-wrap .roster {
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
	justify-content: flex-start;
	width: 70vh;
	padding: 0.4vh 0;
}

/* The scroll bar: a thin ink rail between two of the Tome's diamond marks, and on it a red slider edged in
   gold, as long as the part of the list in view. */
.roster-bar {
	position: relative;
	width: 2vh;
	margin: 0 0 0 1vh;
}

.roster-cap {
	position: absolute;
	left: 0.1vh;
	top: 0;
	width: 1.8vh;
	height: 1.8vh;
}

.roster-cap.bottom {
	top: auto;
	bottom: 0;
}

.roster-rail {
	position: absolute;
	left: 0;
	right: 0;
	top: 2.2vh;
	bottom: 2.2vh;
}

.roster-track {
	position: absolute;
	left: 0.8vh;
	width: 0.4vh;
	top: 0;
	bottom: 0;
	background-color: #5a3a2070;
	border-radius: 0.2vh;
}

.roster-thumb {
	position: absolute;
	left: 0.3vh;
	width: 1.4vh;
	border: 1dp #d9b56a;
	border-radius: 0.7vh;
	decorator: vertical-gradient(#b3301f #6a130c);
	box-shadow: #00000066 0 0.3vh 0.7vh 0;
}

.tile {
	width: 15vh;
	margin: 0.2vh 0.4vh;
	padding: 0.5vh;
	border: 2dp transparent;
	border-radius: 8dp;
	text-align: center;
}

/* The character's portrait (from the player's disc: frontend.cpp
   ensure_portraits), the chapter pictures' 126x89 shape. */
.portrait {
	height: 10.6vh;
	border: 1dp #5a3a20;
	background-color: #3a24120f;
	box-shadow: #00000059 0 0.4vh 0.9vh 0;
}

.portrait img {
	width: 100%;
	height: 100%;
}

/* Default's frame: the game's emblem, whole, on the dark of the night it shows. */
.portrait img.emblem {
	width: auto;
	height: 100%;
}

.tile.default .portrait {
	text-align: center;
	background-color: #0b0d12;
}

/* One line always, so every frame is the same height ("The Custodian" fits at this size). */
.name {
	margin-top: 0.2vh;
	font-size: 2.3vh;
	white-space: nowrap;
	overflow: hidden;
}

/* Which form they're in, on each frame with more than one. */
.tile-form {
	height: 2.3vh;
	font-size: 2vh;
	color: #7a1616;
}

/* The highlighted character: the menus' glowing frame. */
.tile.selected {
	color: #1a0f08;
	border-color: #d4f0ff;
	background-color: #cfeeff40;
	box-shadow: #6ec4ff 0 0 22dp 6dp, #9fdcffd0 0 0 10dp 2dp inset;
}

/* The character in force: a glowing gold frame, their name in red ink. When it's also the highlighted one,
   the highlight's blue glow is inside the gold. */
.tile.chosen {
	border-width: 3dp;
	border-color: #ffd24a;
	background-color: #ffd24a3a;
	box-shadow: #ffc21f 0 0 30dp 9dp, #ffe48a 0 0 14dp 4dp inset;
}

.tile.chosen.selected {
	border-color: #fff4c8;
	background-color: #ffe9a040;
	box-shadow: #ffc21f 0 0 34dp 11dp, #bfe6ff 0 0 12dp 4dp inset;
}

.tile.chosen .name,
.row.chosen .label {
	color: #8e1b12;
}

body.roster .row {
	width: 64vh;
	margin: 0 auto;
	justify-content: center;
	font-size: 3.2vh;
	min-height: 4.2vh;
}

body.roster .row .leader {
	flex: 0;
	min-width: 1.2vh;
	width: 1.2vh;
}

body.roster .gap {
	height: 0.8vh;
}

/* The details: a card laid on the page, with a band of the Tome's leather behind the name and a lighter
   leaf of parchment under it, edged in gold, with a shadow under the whole, so it stands off the page. */
.roster-details {
	flex: 1;
	margin: 0.6vh 0 0 2vh;
	border: 2dp #2a170c;
	border-radius: 10dp;
	box-shadow: #00000080 0 0.8vh 2.4vh 0;
	decorator: image(tome/parchment.png fill);
}

.bio-name {
	padding: 1.2vh 2.4vh 1vh 2.4vh;
	font-size: 4.6vh;
	color: #ecdcb4;
	font-effect: shadow(0 2dp #000000c0);
	border-bottom: 2dp #b08a45;
	border-radius: 8dp 8dp 0 0;
	decorator: image(tome/leather.png cover);
}

.bio-body {
	padding: 1.2vh 2.6vh 1.8vh 2.6vh;
}

.bio-year {
	font-size: 2.8vh;
	color: #5a3a20;
	margin-bottom: 1vh;
}

/* The form, in red ink between the Tome's ornaments (res/ui/tome): every frame has one, "Original form" for
   their own body, so every character's panel is laid out the same. */
.bio-form {
	margin-bottom: 0.6vh;
	text-align: center;
}

.bio-form-rule {
	height: 2vh;
	decorator: image(tome/divider.png fill);
}

.bio-form-name {
	margin: 0.2vh 0;
	font-size: 3.4vh;
	color: #7a1616;
}

/* Whose stats the meters are (a form's are its character's). */
.bio-plays {
	margin-top: 0.8vh;
	font-size: 2.3vh;
	color: #5a3a20;
}

.bio-about {
	font-size: 2.5vh;
	height: 15vh;
	overflow: hidden;
}

.meters {
	margin-top: 0.6vh;
}

.meter {
	display: flex;
	align-items: center;
	margin: 0.6vh 0;
}

.meter-name {
	width: 11vh;
	font-size: 2.7vh;
}

.meter-bar {
	flex: 1;
	height: 1.6vh;
	border: 1dp #2a1810;
	border-radius: 0.6vh;
	background-color: #2a181030;
}

.meter-fill {
	height: 100%;
	border-radius: 0.6vh;
}

.meter-fill.health { background-color: #9c1a12; }
.meter-fill.magick { background-color: #1f3f9c; }
.meter-fill.sanity { background-color: #2d7a2a; }

.meter-value {
	width: 5vh;
	margin-left: 1vh;
	font-size: 2.4vh;
	color: #2a1810;
}

/* The launcher: the picture fills the window and the menu sits on its blank
   parchment (the middle third across, 41% to 88% down); no heading, notes or
   directions. */
body.launcher {
	decorator: image(launcher.png cover);
	image-color: #ffffff;
	font-size: 25dp;
}

body.launcher #book {
	position: absolute;
	left: 34%;
	top: 41%;
	width: 32%;
	height: 47%;
	padding: 0;
	decorator: none;
	align-items: center;
	justify-content: center;
}

body.launcher #pages,
body.pause #pages {
	display: block;
	flex: none;
	width: 100%;
}

body.launcher .page,
body.pause .page,
body.launcher .menu,
body.pause .menu {
	display: block;
}

body.launcher .page {
	padding: 0;
}

body.launcher #heading,
body.launcher .note,
body.launcher #hint {
	display: none;
}

/* Continue, Main menu, Load game, Options, Mods and Quit, with their two
   breaks, all on the parchment. Each row a frame's width, centred. */
body.launcher .row {
	width: 62%;
	min-height: 0;
	margin: 0 auto;
	justify-content: center;
	font-size: 26dp;
	padding: 1dp 2dp;
	color: #2a1810;
}

body.launcher .row.big {
	font-size: 36dp;
	padding: 2dp 2dp;
}

body.launcher .row .leader {
	flex: 0;
	min-width: 16dp;
	width: 16dp;
}

body.launcher .gap,
body.pause .gap {
	height: 16dp;
	margin: 2dp 70dp;
	decorator: image(tome/rule.png contain center center);
}

/* The pause menu (the game's menu over it, dimmed): the launcher's parchment
   in its frame (res/ui/pause.png, cut from launcher.png), the rows centred
   on it in the launcher's ink, the chosen one in the glowing frame. */
body.pause {
	font-size: 25dp;
}

body.pause #book {
	width: 44%;
	height: 72%;
	padding: 0;
	align-items: center;
	justify-content: center;
}

body.pause .page {
	padding: 0 0 2% 0;
}

body.pause .note {
	display: none;
}

body.pause #heading {
	font-size: 34dp;
	margin-bottom: 8dp;
}

body.pause .row {
	width: 62%;
	min-height: 0;
	margin: 0 auto;
	justify-content: center;
	font-size: 26dp;
	padding: 1dp 2dp;
	color: #2a1810;
}

/* Choose Character: each player's card, side by side on a wide page. A card is a leaf of parchment laid on
   the page with a shadow under it; at its top the player in small capitals between the Tome's rules, then
   their chosen character in a leather mount edged in gold that glows in the player's colour (gold for the
   first, blue for the second), their name, form, meters and stats. The highlighted card glows all round. */
body.cards #book {
	width: 150vh;
	max-width: 97vw;
	height: 95vh;
	margin-bottom: 3vh;
	padding: 5vh 0 5vh 0;
}

body.cards #heading {
	font-size: 6vh;
}

body.cards .page {
	padding: 0 8vh;
}

body.cards .note {
	display: none;
}

body.cards .row {
	width: 40vh;
	margin: 0 auto;
	justify-content: center;
}

.pcards {
	display: flex;
	justify-content: center;
	align-items: flex-start;
	margin: 1.6vh 0 1.2vh 0;
}

.pcard {
	width: 48vh;
	padding: 1.6vh 2.6vh 1.6vh 2.6vh;
	border: 2dp #2a170c;
	border-radius: 12dp;
	text-align: center;
	decorator: image(tome/parchment.png fill);
	box-shadow: #00000080 0 1vh 2.6vh 0;
}

.pcard.p1.selected {
	border-width: 3dp;
	border-color: #ffd24a;
	box-shadow: #ffc21f 0 0 44dp 14dp, #ffe48a90 0 0 16dp 4dp inset;
}

.pcard.p2.selected {
	border-width: 3dp;
	border-color: #c8ecff;
	box-shadow: #3aa8ff 0 0 44dp 14dp, #bfe6ff90 0 0 16dp 4dp inset;
}

.pcard.off {
	opacity: 0.6;
}

.pcard-head {
	display: flex;
	align-items: center;
}

.pcard-rule {
	flex: 1;
	height: 2vh;
	decorator: image(tome/divider.png fill);
}

.pcard-who {
	margin: 0 1.4vh;
	font-family: "IM FELL English SC";
	font-size: 3.6vh;
	color: #7a1616;
	font-effect: glow(1dp 5dp #ffcf6a);
}

.pcard.p2 .pcard-who {
	color: #1f3f7a;
	font-effect: glow(1dp 5dp #9fd8ff);
}

.pcard-frame {
	width: 35vh;
	height: 24.7vh;
	margin: 1.2vh auto 0.8vh auto;
	padding: 0.9vh;
	border: 2dp #c79a4a;
	border-radius: 8dp;
	decorator: image(tome/leather.png cover);
	box-shadow: #ffb43a 0 0 26dp 6dp, #000000b0 0 0 12dp 3dp inset;
}

.pcard.p2 .pcard-frame {
	border-color: #8fc8f0;
	box-shadow: #4fb4ff 0 0 26dp 6dp, #000000b0 0 0 12dp 3dp inset;
}

.pcard-portrait {
	width: 100%;
	height: 100%;
	text-align: center;
	border: 1dp #00000099;
}

.pcard-portrait img {
	width: 100%;
	height: 100%;
}

.pcard-frame.default .pcard-portrait {
	background-color: #0b0d12;
}

.pcard-portrait img.emblem {
	width: auto;
	height: 100%;
}

.pcard-name {
	font-size: 4.8vh;
	color: #1a0f08;
}

.pcard-form {
	height: 3.4vh;
	font-size: 3vh;
	color: #7a1616;
}

.pcard-meters {
	margin: 0.8vh 1vh 0 1vh;
	text-align: left;
}

.pcard-default {
	height: 12.2vh;
	margin: 0.8vh 2vh 0 2vh;
	font-size: 2.6vh;
	color: #4a3018;
}

.pcard-foot {
	margin-top: 0.8vh;
	font-size: 2.3vh;
	color: #5a3a20;
}

.pcard-press {
	height: 2.8vh;
	margin-top: 0.4vh;
	font-size: 2.3vh;
	color: #8e1b12;
}

/* Between the cards: a thin red line, the Tome's diamond, and the line again. */
.pcards-mid {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 7vh;
	margin-top: 16vh;
}

.pcards-line {
	width: 2dp;
	height: 13vh;
	background-color: #7a161670;
}

.pcards-mark {
	width: 3.2vh;
	height: 3.2vh;
	margin: 1vh 0;
}
