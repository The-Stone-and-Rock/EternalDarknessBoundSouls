/* RmlUi has no default style sheet: declare what the menu uses. */
div { display: block; }
span { display: inline; }

/* Every submenu, in the launcher and over the game: one sheet of the parchment
   (res/ui/pause.png), sized by the window's height, so it keeps its shape and
   everything on it fits at any window size. Behind it, the launcher's picture
   dimmed; over the game, the dimmed paused frame. */
body {
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	font-family: "IM FELL English";
	font-weight: normal;
	font-size: 3.2vh;
	color: #2a1810;
	background-color: #000000;
	decorator: image(launcher.png cover);
	image-color: #5c5c5c;
}

/* Over the game the page sits on the dimmed, paused frame. */
body.overlay {
	background-color: #000000b0;
	decorator: none;
}

#book {
	display: flex;
	flex-direction: column;
	width: 102.6vh;   /* the picture's own shape, 706 by 578 */
	height: 84vh;
	padding: 5.5vh 0 6.5vh 0;
	box-sizing: border-box;
	decorator: image(pause.png fill);
}

#heading {
	font-size: 5vh;
	text-align: center;
	flex-shrink: 0;
}

#pages {
	display: flex;
	flex: 1;
	min-height: 0;
}

.page {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding: 0 16vh;
}

.menu {
	display: flex;
	flex-direction: column;
	flex: 1;
	justify-content: center;
}

/* Button mapping: two columns on the one sheet. */
#page1 {
	display: none;
}

body.spread #page1 {
	display: flex;
}

body.spread .page {
	padding: 0 2vh 0 8vh;
}

body.spread #page1 {
	padding: 0 8vh 0 2vh;
}

body.spread .menu {
	justify-content: flex-start;
	margin-top: 1vh;
}

/* A small heading over a group of rows. */
.section {
	font-size: 2.4vh;
	color: #4a3018;
	padding: 0 1.4vh;
	margin: 1.4vh 0 0.3vh 0;
}

/* A break between groups of rows: only space. */
.gap {
	height: 1.8vh;
	flex-shrink: 0;
}

/* A row: the name at the left, its control at the right. Each has a frame of
   its own, shown round the chosen one. */
.row {
	display: flex;
	align-items: center;
	flex-shrink: 0;
	min-height: 3.3vh;
	padding: 0.1vh 1.2vh;
	border: 2dp transparent;
	border-radius: 8dp;
}

/* After a row's name: "(Experimental, expect glitches)", smaller, in the Tome's red. */
.tag {
	font-size: 1.6vh;
	color: #8a2a1a;
	margin-left: 1vh;
	white-space: nowrap;
}

/* The settings pages: every value in one column at the right, its arrows on the column's edges and the value
   centred between them, a switch or a level in its middle, and a page's arrow at its right end. */
body.settings .value {
	min-width: 30vh;
	justify-content: center;
}

body.settings .value.opens {
	justify-content: flex-end;
}

body.settings .value.choice .pick {
	flex: 1 0 auto;
	min-width: 0;
}

.leader {
	flex: 1;
	min-width: 2vh;
}

.value {
	display: flex;
	align-items: center;
	white-space: nowrap;
}

/* The longest pages (Controls, Button mapping): the same letters, smaller, so
   every row stays on the sheet. */
body.dense .row {
	font-size: 2.6vh;
}

/* Back, and the plain lists of actions (a save slot's page): centred. */
.row.back,
body.centered .row {
	justify-content: center;
}

.row.back {
	width: 40%;
	margin: 0 auto;
}

body.centered .row {
	width: 60%;
	margin: 0 auto;
}

body.centered .row .leader {
	flex: 0;
	min-width: 1.2vh;
	width: 1.2vh;
}

/* A choice among several: arrows round it, the value in the middle so it stays
   put as it changes. */
.chev {
	display: block;
	width: 2.6vh;
	height: 2.6vh;
	line-height: 2.2vh;
	font-size: 3.6vh;
	text-align: center;
	color: #7a2012;
}

.pick {
	display: block;
	min-width: 16vh;
	text-align: center;
}

/* On or off. Red ink with the knob to the right, or a hollow outline. */
.switch {
	display: block;
	width: 4.8vh;
	height: 2.4vh;
	box-sizing: border-box;
	border: 2dp #5a3a20;
	border-radius: 1.2vh;
	background-color: #2a181018;
}

.switch.on {
	border-color: #6a140d;
	background-color: #8e1b12;
}

.knob {
	display: block;
	width: 1.5vh;
	height: 1.5vh;
	margin: 0.25vh 0 0 0.25vh;
	border-radius: 0.75vh;
	background-color: #5a3a20;
}

.switch.on .knob {
	margin-left: 2.65vh;
	background-color: #f0e4c8;
}

/* A level from none to all (the volumes). */
.slider {
	display: block;
	width: 15vh;
	height: 1vh;
	box-sizing: border-box;
	border: 1dp #5a3a20;
	border-radius: 0.5vh;
	background-color: #2a181018;
}

.slider-fill {
	display: block;
	height: 100%;
	border-radius: 0.5vh;
	background-color: #8e1b12;
}

.slider-value {
	display: block;
	width: 8vh;
	text-align: right;
}

/* The chosen row: the game's own glowing frame (its memory card screen's),
   the ink kept black. */
.row.selected {
	color: #1a0f08;
	border-color: #d4f0ff;
	background-color: #cfeeff40;
	box-shadow: #6ec4ff 0 0 22dp 6dp, #9fdcffd0 0 0 10dp 2dp inset;
}

.row.selected .value {
	color: #1a0f08;
}

.row.disabled,
.row.disabled .value {
	color: #7a6a52;
}

.row.selected.disabled {
	color: #6a5a4a;
}

.row.disabled .switch {
	border-color: #8a7a62;
	background-color: transparent;
}

.row.disabled .switch .knob {
	background-color: #8a7a62;
}

/* The chosen row's help, always the same height, so a longer text never moves
   the rows as the selection moves. */
.note {
	flex-shrink: 0;
	height: 5.6vh;
	overflow: hidden;
	margin: 1vh 12vh 0 12vh;
	font-size: 2.2vh;
	color: #4a3018;
	text-align: center;
}

#hint {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 2.2vh;
	font-size: 2.2vh;
	color: #d2bf98;
	text-align: center;
}

/* Button and key icons (Kenney Input Prompts, CC0) in their menu versions
   (res/ui/glyphs/ink: white keys with an ink rim, coloured buttons as they
   are), drawn straight on the parchment. */
img.glyph {
	width: 3.2vh;
	height: 3.2vh;
	margin-left: 0.4vh;
	vertical-align: middle;
}

.sep {
	display: inline-block;
	width: 1.8vh;
}

.keycap {
	display: inline-block;
	padding: 0.1vh 0.8vh;
	margin-left: 0.4vh;
	border: 1dp #5a3a20;
	border-radius: 4dp;
	font-size: 1.7vh;
	color: #2a1810;
	vertical-align: middle;
}

.unbound {
	color: #8a7a62;
}

/* Character select: every character at once, a frame for their portrait over
   their name, and beside them the highlighted character's details. */
body.roster #book {
	width: 150vh;
	max-width: 97vw;
	height: 95vh;
	margin-bottom: 3vh;
	padding: 5vh 0 5vh 0;
}

body.roster #heading {
	font-size: 6vh;
}

body.roster .page {
	padding: 0 10vh;
}

body.roster .note {
	display: none;
}

.roster-wrap {
	display: flex;
	align-items: flex-start;
}

/* The frames, three lines in view; the rest come a line at a time (frontend.cpp roster_keep_in_view), with
   a bar beside them showing where the view is. The details panel beside them stays. */
.roster-scroll {
	display: flex;
	flex-shrink: 0;
	height: 56vh;
}

.roster-wrap .roster {
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
	justify-content: flex-start;
	width: 70vh;
	padding: 0.4vh 0;
}

/* The scroll bar: a thin ink rail between two of the Tome's diamond marks, and on it a red slider edged in
   gold, as long as the part of the list in view. */
.roster-bar {
	position: relative;
	width: 2vh;
	margin: 0 0 0 1vh;
}

.roster-cap {
	position: absolute;
	left: 0.1vh;
	top: 0;
	width: 1.8vh;
	height: 1.8vh;
}

.roster-cap.bottom {
	top: auto;
	bottom: 0;
}

.roster-rail {
	position: absolute;
	left: 0;
	right: 0;
	top: 2.2vh;
	bottom: 2.2vh;
}

.roster-track {
	position: absolute;
	left: 0.8vh;
	width: 0.4vh;
	top: 0;
	bottom: 0;
	background-color: #5a3a2070;
	border-radius: 0.2vh;
}

.roster-thumb {
	position: absolute;
	left: 0.3vh;
	width: 1.4vh;
	border: 1dp #d9b56a;
	border-radius: 0.7vh;
	decorator: vertical-gradient(#b3301f #6a130c);
	box-shadow: #00000066 0 0.3vh 0.7vh 0;
}

.tile {
	width: 15vh;
	margin: 0.2vh 0.4vh;
	padding: 0.5vh;
	border: 2dp transparent;
	border-radius: 8dp;
	text-align: center;
}

/* The character's portrait (from the player's disc: frontend.cpp
   ensure_portraits), the chapter pictures' 126x89 shape. */
.portrait {
	height: 10.6vh;
	border: 1dp #5a3a20;
	background-color: #3a24120f;
	box-shadow: #00000059 0 0.4vh 0.9vh 0;
}

.portrait img {
	width: 100%;
	height: 100%;
}

/* Default's frame: the game's emblem, whole, on the dark of the night it shows. */
.portrait img.emblem {
	width: auto;
	height: 100%;
}

.tile.default .portrait {
	text-align: center;
	background-color: #0b0d12;
}

/* One line always, so every frame is the same height ("The Custodian" fits at this size). */
.name {
	margin-top: 0.2vh;
	font-size: 2.3vh;
	white-space: nowrap;
	overflow: hidden;
}

/* Which form they're in, on each frame with more than one. */
.tile-form {
	height: 2.3vh;
	font-size: 2vh;
	color: #7a1616;
}

/* The highlighted character: the menus' glowing frame. */
.tile.selected {
	color: #1a0f08;
	border-color: #d4f0ff;
	background-color: #cfeeff40;
	box-shadow: #6ec4ff 0 0 22dp 6dp, #9fdcffd0 0 0 10dp 2dp inset;
}

/* The character in force: a glowing gold frame, their name in red ink. When it's also the highlighted one,
   the highlight's blue glow is inside the gold. */
.tile.chosen {
	border-width: 3dp;
	border-color: #ffd24a;
	background-color: #ffd24a3a;
	box-shadow: #ffc21f 0 0 30dp 9dp, #ffe48a 0 0 14dp 4dp inset;
}

.tile.chosen.selected {
	border-color: #fff4c8;
	background-color: #ffe9a040;
	box-shadow: #ffc21f 0 0 34dp 11dp, #bfe6ff 0 0 12dp 4dp inset;
}

.tile.chosen .name,
.row.chosen .label {
	color: #8e1b12;
}

body.roster .row {
	width: 64vh;
	margin: 0 auto;
	justify-content: center;
	font-size: 3.2vh;
	min-height: 4.2vh;
}

body.roster .row .leader {
	flex: 0;
	min-width: 1.2vh;
	width: 1.2vh;
}

body.roster .gap {
	height: 0.8vh;
}

/* The details: a card laid on the page, with a band of the Tome's leather behind the name and a lighter
   leaf of parchment under it, edged in gold, with a shadow under the whole, so it stands off the page. */
.roster-details {
	flex: 1;
	margin: 0.6vh 0 0 2vh;
	border: 2dp #2a170c;
	border-radius: 10dp;
	box-shadow: #00000080 0 0.8vh 2.4vh 0;
	decorator: image(tome/parchment.png fill);
}

.bio-name {
	padding: 1.2vh 2.4vh 1vh 2.4vh;
	font-size: 4.6vh;
	color: #ecdcb4;
	font-effect: shadow(0 2dp #000000c0);
	border-bottom: 2dp #b08a45;
	border-radius: 8dp 8dp 0 0;
	decorator: image(tome/leather.png cover);
}

.bio-body {
	padding: 1.2vh 2.6vh 1.8vh 2.6vh;
}

.bio-year {
	font-size: 2.8vh;
	color: #5a3a20;
	margin-bottom: 1vh;
}

/* The form, in red ink between the Tome's ornaments (res/ui/tome): every frame has one, "Original form" for
   their own body, so every character's panel is laid out the same. */
.bio-form {
	margin-bottom: 0.6vh;
	text-align: center;
}

.bio-form-rule {
	height: 2vh;
	decorator: image(tome/divider.png fill);
}

.bio-form-name {
	margin: 0.2vh 0;
	font-size: 3.4vh;
	color: #7a1616;
}

/* Whose stats the meters are (a form's are its character's). */
.bio-plays {
	margin-top: 0.8vh;
	font-size: 2.3vh;
	color: #5a3a20;
}

.bio-about {
	font-size: 2.5vh;
	height: 15vh;
	overflow: hidden;
}

.meters {
	margin-top: 0.6vh;
}

.meter {
	display: flex;
	align-items: center;
	margin: 0.6vh 0;
}

.meter-name {
	width: 11vh;
	font-size: 2.7vh;
}

.meter-bar {
	flex: 1;
	height: 1.6vh;
	border: 1dp #2a1810;
	border-radius: 0.6vh;
	background-color: #2a181030;
}

.meter-fill {
	height: 100%;
	border-radius: 0.6vh;
}

.meter-fill.health { background-color: #9c1a12; }
.meter-fill.magick { background-color: #1f3f9c; }
.meter-fill.sanity { background-color: #2d7a2a; }

.meter-value {
	width: 5vh;
	margin-left: 1vh;
	font-size: 2.4vh;
	color: #2a1810;
}

/* The launcher: the picture fills the window and the menu sits on its blank
   parchment (the middle third across, 41% to 88% down); no heading, notes or
   directions. */
body.launcher {
	decorator: image(launcher.png cover);
	image-color: #ffffff;
	font-size: 25dp;
}

body.launcher #book {
	position: absolute;
	left: 34%;
	top: 41%;
	width: 32%;
	height: 47%;
	padding: 0;
	decorator: none;
	align-items: center;
	justify-content: center;
}

body.launcher #pages,
body.pause #pages {
	display: block;
	flex: none;
	width: 100%;
}

body.launcher .page,
body.pause .page,
body.launcher .menu,
body.pause .menu {
	display: block;
}

body.launcher .page {
	padding: 0;
}

body.launcher #heading,
body.launcher .note,
body.launcher #hint {
	display: none;
}

/* Continue, Main menu, Load game, Options, Mods and Quit, with their two
   breaks, all on the parchment. Each row a frame's width, centred. */
body.launcher .row {
	width: 62%;
	min-height: 0;
	margin: 0 auto;
	justify-content: center;
	font-size: 26dp;
	padding: 1dp 2dp;
	color: #2a1810;
}

body.launcher .row.big {
	font-size: 36dp;
	padding: 2dp 2dp;
}

/* The launcher's rows a little closer, for the tags under three of them: the same letters, all still on the
   parchment. */
body.launcher .row {
	line-height: 26dp;
}

body.launcher .row.big {
	line-height: 38dp;
}

body.launcher .menu .gap {
	height: 12dp;
}

/* A tagged row on the centred launcher: its name centred as the others', the tag in small letters under it. */
body.launcher .row.tagged {
	flex-direction: column;
}

body.launcher .tag {
	font-size: 13dp;
	line-height: 13dp;
	margin: -4dp 0 0 0;
}

body.launcher .row .leader {
	flex: 0;
	min-width: 16dp;
	width: 16dp;
}

body.launcher .gap,
body.pause .gap {
	height: 16dp;
	margin: 2dp 70dp;
	decorator: image(tome/rule.png contain center center);
}

/* The first-run step (frontend.cpp run_preparing): "Preparing the game from your disc" on the launcher's parchment,
   what is being made, a bar in the launcher's ink and how far it is. */
body.preparing .prep {
	display: block;
	width: 100%;
	text-align: center;
	color: #2a1810;
}

body.preparing .prep-title {
	font-size: 36dp;
	line-height: 40dp;
}

body.preparing .prep-sub {
	font-size: 24dp;
	line-height: 28dp;
	color: #4a3018;
}

body.preparing .prep .gap {
	margin: 10dp 70dp 14dp 70dp;
}

body.preparing .prep-doing {
	font-size: 20dp;
	line-height: 24dp;
}

body.preparing .prep-bar {
	width: 78%;
	height: 14dp;
	margin: 10dp auto 6dp auto;
	border: 1dp #2a1810;
	border-radius: 5dp;
	background-color: #2a181026;
}

body.preparing .prep-fill {
	height: 100%;
	border-radius: 5dp;
	background-color: #6b1a12;
}

body.preparing .prep-count {
	font-size: 16dp;
	line-height: 20dp;
	color: #4a3018;
}

body.preparing .prep-note {
	margin-top: 18dp;
	font-size: 14dp;
	line-height: 18dp;
	color: #5a4028;
}

body.preparing .prep-skip {
	margin-top: 4dp;
	font-size: 13dp;
	line-height: 16dp;
	color: #7a6a52;
}

/* The pause menu (the game's menu over it, dimmed): the launcher's parchment
   in its frame (res/ui/pause.png, cut from launcher.png), the rows centred
   on it in the launcher's ink, the chosen one in the glowing frame. */
body.pause {
	font-size: 25dp;
}

body.pause #book {
	width: 44%;
	height: 72%;
	padding: 0;
	align-items: center;
	justify-content: center;
}

body.pause .page {
	padding: 0 0 2% 0;
}

body.pause .note {
	display: none;
}

body.pause #heading {
	font-size: 34dp;
	margin-bottom: 8dp;
}

body.pause .row {
	width: 62%;
	min-height: 0;
	margin: 0 auto;
	justify-content: center;
	font-size: 26dp;
	padding: 1dp 2dp;
	color: #2a1810;
}

/* Choose Character: each player's card, side by side on a wide page. A card is a leaf of parchment laid on
   the page with a shadow under it; at its top the player in small capitals between the Tome's rules, then
   their chosen character in a leather mount edged in gold that glows in the player's colour (gold for the
   first, blue for the second), their name, form, meters and stats. The highlighted card glows all round. */
body.cards #book {
	width: 150vh;
	max-width: 97vw;
	height: 95vh;
	margin-bottom: 3vh;
	padding: 5vh 0 5vh 0;
}

body.cards #heading {
	font-size: 6vh;
}

body.cards .page {
	padding: 0 8vh;
}

body.cards .note {
	display: none;
}

body.cards .row {
	width: 40vh;
	margin: 0 auto;
	justify-content: center;
}

.pcards {
	display: flex;
	justify-content: center;
	align-items: flex-start;
	margin: 1.6vh 0 1.2vh 0;
}

.pcard {
	width: 48vh;
	padding: 1.6vh 2.6vh 1.6vh 2.6vh;
	border: 2dp #2a170c;
	border-radius: 12dp;
	text-align: center;
	decorator: image(tome/parchment.png fill);
	box-shadow: #00000080 0 1vh 2.6vh 0;
}

.pcard.p1.selected {
	border-width: 3dp;
	border-color: #ffd24a;
	box-shadow: #ffc21f 0 0 44dp 14dp, #ffe48a90 0 0 16dp 4dp inset;
}

.pcard.p2.selected {
	border-width: 3dp;
	border-color: #c8ecff;
	box-shadow: #3aa8ff 0 0 44dp 14dp, #bfe6ff90 0 0 16dp 4dp inset;
}

.pcard.off {
	opacity: 0.6;
}

.pcard-head {
	display: flex;
	align-items: center;
}

.pcard-rule {
	flex: 1;
	height: 2vh;
	decorator: image(tome/divider.png fill);
}

.pcard-who {
	margin: 0 1.4vh;
	font-family: "IM FELL English SC";
	font-size: 3.6vh;
	color: #7a1616;
	font-effect: glow(1dp 5dp #ffcf6a);
}

.pcard.p2 .pcard-who {
	color: #1f3f7a;
	font-effect: glow(1dp 5dp #9fd8ff);
}

.pcard-frame {
	width: 35vh;
	height: 24.7vh;
	margin: 1.2vh auto 0.8vh auto;
	padding: 0.9vh;
	border: 2dp #c79a4a;
	border-radius: 8dp;
	decorator: image(tome/leather.png cover);
	box-shadow: #ffb43a 0 0 26dp 6dp, #000000b0 0 0 12dp 3dp inset;
}

.pcard.p2 .pcard-frame {
	border-color: #8fc8f0;
	box-shadow: #4fb4ff 0 0 26dp 6dp, #000000b0 0 0 12dp 3dp inset;
}

.pcard-portrait {
	width: 100%;
	height: 100%;
	text-align: center;
	border: 1dp #00000099;
}

.pcard-portrait img {
	width: 100%;
	height: 100%;
}

.pcard-frame.default .pcard-portrait {
	background-color: #0b0d12;
}

.pcard-portrait img.emblem {
	width: auto;
	height: 100%;
}

.pcard-name {
	font-size: 4.8vh;
	color: #1a0f08;
}

.pcard-form {
	height: 3.4vh;
	font-size: 3vh;
	color: #7a1616;
}

.pcard-meters {
	margin: 0.8vh 1vh 0 1vh;
	text-align: left;
}

.pcard-default {
	height: 12.2vh;
	margin: 0.8vh 2vh 0 2vh;
	font-size: 2.6vh;
	color: #4a3018;
}

.pcard-foot {
	margin-top: 0.8vh;
	font-size: 2.3vh;
	color: #5a3a20;
}

.pcard-press {
	height: 2.8vh;
	margin-top: 0.4vh;
	font-size: 2.3vh;
	color: #8e1b12;
}

/* Between the cards: a thin red line, the Tome's diamond, and the line again. */
.pcards-mid {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 7vh;
	margin-top: 16vh;
}

.pcards-line {
	width: 2dp;
	height: 13vh;
	background-color: #7a161670;
}

.pcards-mark {
	width: 3.2vh;
	height: 3.2vh;
	margin: 1vh 0;
}

/* The two-card page (Solo / Co-op, Player I / Player II): Choose Character's cards, larger, with no meters. Co-op's
   card holds two mounts: player 1's in front in gold, player 2's behind and up to the right in blue. */
.pcard.pickcard {
	width: 52vh;
}

.pcard.pickcard .pcard-frame {
	box-sizing: border-box;
	width: 46vh;
	height: 32.5vh;
}

.pcard-pair {
	position: relative;
	width: 46vh;
	height: 32.5vh;
	margin: 1.2vh auto 0.8vh auto;
}

.pcard.pickcard .pcard-pair .pcard-frame {
	position: absolute;
	width: 38vh;
	height: 26.8vh;
	margin: 0;
}

.pcard-pair .pcard-frame.behind {
	left: 8vh;
	top: 0;
}

.pcard-pair .pcard-frame.front {
	left: 0;
	top: 5.7vh;
}

.pcard-frame.p2-frame {
	border-color: #8fc8f0;
	box-shadow: #4fb4ff 0 0 26dp 6dp, #000000b0 0 0 12dp 3dp inset;
}

body.pickpage .pcards-mid {
	margin-top: 20vh;
}

/* A list that scrolls (frontend.cpp g_list_lines): the Tome's diamond above it when rows are hidden above, and under
   it when rows are hidden below. The launcher's look never scrolls its lists. */
.list-more {
	display: flex;
	justify-content: center;
	height: 1.8vh;
	flex-shrink: 0;
	margin: 0.3vh 0;
}

.list-more img {
	width: 1.6vh;
	height: 1.6vh;
	opacity: 0.7;
}

/* The looks the caller chooses (frontend_open_page_skin): body.skin-title over the title screen, body.skin-tome on a
   Tome page. Each gets its block here, after every rule above, so it wins (the Tome's is at the end of the file). */

#backdrop {
	display: none;
}

#veil {
	display: none;
}

#rule {
	display: none;
}

/* ---- The title look: every page opened from the title. ----
   The title's Options picture, its painted words erased (res/video/options-clean.png, made from the player's own disc
   by titlevideo.cpp), laid where the game lays it (frontend.cpp render sets #backdrop's place). No parchment: the
   game's hand (La Belle Aurore) in the painted rows' teal (72, 97, 104), the chosen row pale cyan (0xA0E3F1) with a
   soft glow, as the game lights its words. Values and notes in IM Fell, lighter, to stay readable small. */
body.skin-title {
	background-color: #000000;
	decorator: none;
	color: #5e848d;
}

/* #backdrop is the game's picture in the window (cut to it, as the game's is), #backdrop-picture the Options picture
   where the game lays it, wider than the window at 16:9 and 4:3 alike. */
body.skin-title #backdrop {
	display: block;
	position: absolute;
	z-index: -1;  /* under the page: a positioned box paints over the ones in the flow */
	overflow: hidden;
	clip: always;  /* (RmlUi clips only content it counts as overflow, which a positioned child is not) */
}

body.skin-title #backdrop-picture {
	position: absolute;
}

/* Only once the picture is written (frontend.cpp title_art_ready): RmlUi never loads a picture again after one try
   failed, so asking for it too early would keep it black for the whole run. */
body.skin-title.title-art #backdrop-picture {
	decorator: image(../video/options-clean.png fill);
}

/* The HD pack's Options picture, its words' box blacked (res/video/options-clean-hd.png, 1700x960, written at boot by
   titlevideo.cpp when the pack has it and HD textures are on): in place of the disc's (frontend.cpp title-art-hd). */
body.skin-title.title-art-hd #backdrop-picture {
	decorator: image(../video/options-clean-hd.png fill);
}

body.skin-title #book {
	decorator: none;
	background-color: #03090bd8;
	border: 1px #48616890;
	border-radius: 1.6vh;
}

body.skin-title #heading {
	font-family: "La Belle Aurore";
	color: #6a939c;
}

body.skin-title .row {
	font-family: "La Belle Aurore";
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	box-shadow: none;
	color: #5e848d;
}

body.skin-title .row.selected,
body.skin-title .row.selected .value {
	color: #a0e3f1;
	font-effect: glow(1px 9px #a0e3f188);
}

body.skin-title .row.disabled,
body.skin-title .row.disabled .value {
	color: #2f4348;
}

body.skin-title .row.selected.disabled {
	color: #4a6a72;
}

body.skin-title .row.chosen .label {
	color: #c9ab68;
}

body.skin-title .value {
	font-family: "IM FELL English";
	color: #8db2ba;
}

body.skin-title .chev {
	color: #6a939c;
}

body.skin-title .switch {
	border-color: #5e848d;
	background-color: #000000c0;
}

body.skin-title .switch.on {
	border-color: #7fb9c6;
	background-color: #2f5a64;
}

body.skin-title .knob {
	background-color: #6a939c;
}

body.skin-title .switch.on .knob {
	background-color: #a0e3f1;
}

body.skin-title .slider {
	border-color: #486168;
	background-color: #00000080;
}

body.skin-title .slider-fill {
	background-color: #5f98a5;
}

body.skin-title .row.disabled .switch {
	border-color: #2f4348;
	background-color: transparent;
}

body.skin-title .row.disabled .switch .knob {
	background-color: #2f4348;
}

body.skin-title .section {
	font-family: "IM FELL English SC";
	color: #486168;
}

body.skin-title .gap {
	decorator: none;
}

body.skin-title .tag {
	font-family: "IM FELL English";
	color: #8a6a4a;
}

body.skin-title .note {
	color: #6d9098;
}

body.skin-title #hint {
	color: #486168;
	font-size: 2vh;
}

body.skin-title .keycap {
	border-color: #486168;
	color: #8db2ba;
}

body.skin-title .unbound {
	color: #3c5459;
}

/* A list page (frontend.cpp: class title-list): in the column where the game paints its Options rows, every size in em
   of the letters' size frontend.cpp sets (a part of the picture's height), so it keeps the picture's proportions in any
   window. The page's name at the game's own row size, then the rows, left-aligned as the game's, the help under them. */
body.skin-title.title-list #book {
	position: absolute;
	margin: 0;
	padding: 0;
	align-items: stretch;
	justify-content: flex-start;
	background-color: transparent;
	border-width: 0;
}

body.skin-title.title-list #heading {
	height: 1.55em;
	line-height: 1.55em;
	margin: 0;
	padding: 0 0 0 0.45em;
	font-size: 1.9em;
	text-align: left;
}

body.skin-title.title-list .page {
	position: relative;
	padding: 0;
}

body.skin-title.title-list .menu {
	justify-content: flex-start;
	margin: 0;
}

body.skin-title.title-list .row,
body.skin-title.title-list.dense .row,
body.skin-title.title-list.centered .row,
body.skin-title.title-list .row.back {
	width: auto;
	min-height: 1.3em;
	height: 1.3em;
	line-height: 1.3em;
	margin: 0;
	padding: 0 0.2em 0 0.85em;
	font-size: 1em;
	justify-content: flex-start;
}

body.skin-title.title-list .row .label {
	white-space: nowrap;
}

body.skin-title.title-list.centered .row .leader {
	flex: 1;
	width: auto;
}

body.skin-title.title-list .value {
	font-size: 0.66em;
	line-height: 1.6em;
	font-effect: glow(2px 4px #000000c0);  /* a dark halo: readable where a value crosses the logo */
}

/* Controls: its values are long ("Automatic (XInput Controller #1)"): smaller, so the row stays clear of the skull. */
body.skin-title.title-list.dense .value {
	font-size: 0.56em;
}

body.skin-title.title-list.settings .value {
	min-width: 7em;
}

/* A row that opens a page: its arrow right after its name. */
body.skin-title.title-list .row.opener .leader {
	flex: 0;
	min-width: 0.3em;
	width: 0.3em;
}

body.skin-title.title-list.settings .row.opener .value {
	min-width: 0;
}

body.skin-title.title-list .chev {
	width: 1em;
	height: 1.6em;
	line-height: 1.6em;
	font-size: 1.3em;
}

body.skin-title.title-list .pick {
	min-width: 4.6em;
}

body.skin-title.title-list .switch {
	width: 2.2em;
	height: 1.1em;
	border-radius: 0.55em;
	border-width: 1px;
}

body.skin-title.title-list .knob {
	width: 0.7em;
	height: 0.7em;
	margin: 0.15em 0 0 0.15em;
	border-radius: 0.35em;
}

body.skin-title.title-list .switch.on .knob {
	margin-left: 1.25em;
}

body.skin-title.title-list .slider {
	width: 4.5em;
	height: 0.4em;
	border-radius: 0.2em;
}

body.skin-title.title-list .slider-fill {
	border-radius: 0.2em;
}

body.skin-title.title-list .slider-value {
	width: 2.6em;
}

body.skin-title.title-list .tag {
	display: none;
}

body.skin-title.title-list .section {
	height: 1.1em;
	line-height: 1.1em;
	margin: 0.4em 0 1.1em 0;
	padding: 0 0 0 1.5em;
	font-size: 0.55em;
}

body.skin-title.title-list .gap {
	height: 0.3em;
}

body.skin-title.title-list img.glyph {
	width: 1.5em;
	height: 1.5em;
	margin-left: 0.2em;
}

body.skin-title.title-list .keycap {
	font-size: 0.8em;
	padding: 0 0.4em;
}

body.skin-title.title-list .note {
	height: 2.7em;
	margin: 0.3em 0 0 0;
	padding: 0 0 0 1.5em;
	font-size: 0.52em;
	text-align: left;
}

body.skin-title.title-list #hint {
	display: none;
}

/* The scroll marks: the painted list's pen-stroke chevrons (res/video/mark-up.png, mark-down.png), beside the first and
   the last row in view, left of their names, as the game's list has them (frontend.cpp render). */
body.skin-title.title-list .row {
	position: relative;
}

.row-mark {
	display: none;
}

body.skin-title.title-list .row-mark {
	display: block;
	position: absolute;
	left: 0;
	top: 0.42em;
	width: 0.66em;
	height: 0.44em;
}

/* The wide pages (the roster, the two players' cards, Button Mapping's two columns): their own places, on the dark,
   half-clear panel above (body.skin-title #book), so the picture shows round it and doesn't fight the frames. */
body.skin-title.roster .row,
body.skin-title.cards .row {
	font-size: 3.6vh;
}

body.skin-title .pcard {
	decorator: none;
	background-color: #0a1518e8;
	border: 1px #3b5359;
	box-shadow: #000000a0 0 1vh 2.6vh 0;
}

body.skin-title .pcard.p1.selected,
body.skin-title .pcard.p2.selected {
	border-width: 2px;
	border-color: #a0e3f1;
	box-shadow: #a0e3f150 0 0 34dp 8dp;
}

body.skin-title .pcard-rule {
	decorator: none;
	height: 1px;
	background-color: #486168;
}

body.skin-title .pcard-who {
	color: #c9ab68;
	font-effect: glow(0px 4px #c9ab6840);
}

body.skin-title .pcard.p2 .pcard-who {
	color: #8fc8f0;
	font-effect: glow(0px 4px #8fc8f040);
}

body.skin-title .pcard-frame {
	decorator: none;
	background-color: #000000;
	border-color: #486168;
	box-shadow: #c9ab6830 0 0 18dp 4dp;
}

body.skin-title .pcard.p2 .pcard-frame {
	border-color: #486168;
	box-shadow: #8fc8f030 0 0 18dp 4dp;
}

body.skin-title .pcard-name {
	font-family: "La Belle Aurore";
	color: #a0e3f1;
}

body.skin-title .pcard-form,
body.skin-title .tile-form,
body.skin-title .bio-form-name {
	color: #c9ab68;
}

body.skin-title .pcard-default,
body.skin-title .pcard-foot {
	color: #6d9098;
}

body.skin-title .pcard-press {
	color: #a0e3f1;
}

body.skin-title .pcards-line {
	background-color: #48616890;
}

body.skin-title .pcard-frame.p2-frame {
	border-color: #486168;
	box-shadow: #8fc8f030 0 0 18dp 4dp;
}

/* Co-op's two mounts: player 1's edged in the gold of "Player I", player 2's in the blue of "Player II". */
body.skin-title .pcard-pair .pcard-frame.front {
	border-color: #c9ab6890;
	box-shadow: #c9ab6840 0 0 18dp 4dp, #000000c0 0 0 10dp 2dp;
}

body.skin-title .pcard-pair .pcard-frame.behind {
	border-color: #8fc8f090;
}

body.skin-title .meter-bar {
	border-color: #486168;
	background-color: #ffffff10;
}

body.skin-title .meter-value {
	color: #8db2ba;
}

body.skin-title .tile {
	color: #6a939c;
}

body.skin-title .name {
	font-family: "La Belle Aurore";
}

body.skin-title .portrait {
	border-color: #486168;
	background-color: #000000;
}

body.skin-title .tile.selected {
	color: #a0e3f1;
	border-color: #a0e3f1;
	background-color: #a0e3f114;
	box-shadow: #a0e3f150 0 0 22dp 4dp;
}

body.skin-title .tile.chosen {
	border-color: #c9ab68;
	background-color: #c9ab6818;
	box-shadow: #c9ab6850 0 0 22dp 5dp;
}

body.skin-title .tile.chosen.selected {
	border-color: #e8dcae;
	background-color: #a0e3f118;
	box-shadow: #c9ab6860 0 0 26dp 6dp, #a0e3f170 0 0 10dp 2dp inset;
}

body.skin-title .tile.chosen .name {
	color: #c9ab68;
}

body.skin-title .roster-details {
	decorator: none;
	background-color: #0a1518e8;
	border: 1px #3b5359;
}

body.skin-title .bio-name {
	decorator: none;
	background-color: #0f2328;
	font-family: "La Belle Aurore";
	color: #a0e3f1;
	font-effect: none;
	border-bottom: 1px #486168;
}

body.skin-title .bio-year,
body.skin-title .bio-plays {
	color: #6d9098;
}

body.skin-title .bio-about {
	color: #8db2ba;
}

body.skin-title .bio-form-rule {
	decorator: none;
	height: 1px;
	margin: 0.9vh 0;
	background-color: #486168;
}

body.skin-title .roster-track {
	background-color: #48616890;
}

body.skin-title .roster-thumb {
	border-color: #a0e3f1;
	decorator: vertical-gradient(#5f98a5 #2f5a64);
}

/* ---- The Tome look: every page opened from a Tome plaque (body.skin-tome). ----
   The page lies on the Tome itself: no veil, so the Tome's frame (the medallion, the bones, the hints) shows round it.
   It is a leaf of parchment (res/ui/tome/parchment.png) laid on the Tome's page, placed and sized by frontend.cpp render
   (tome_units_box, kTomeLeaf), its letters a part of the page's height: every size here is in em of them, so the page
   keeps its shape at any window size. The Tome's ink (38, 27, 17, as tome.cpp kInk), the names in the Tome's hand (La
   Belle Aurore, as the plaques), the values and help in IM Fell (as the Tome's own words); the chosen row in red ink with
   a thin gold ring, as the Tome's own ring round a plaque. One column, scrolling (frontend.cpp kTomeLines).
   No veil only with the Tome under the page (body.tome-under, frontend.cpp tome_under_page): co-op player 1's page is
   over the world's picture, and keeps body.overlay's dim. */
body.skin-tome {
	color: rgb(38, 27, 17);
}

body.skin-tome.tome-under {
	background-color: transparent;
	decorator: none;
}

body.skin-tome #book {
	position: absolute;
	max-width: none;
	margin: 0;
	padding: 0.9em 1.1em 0.7em 1.1em;
	align-items: stretch;
	justify-content: flex-start;
	decorator: image(tome/parchment.png fill);
	image-color: #d2c8bc;
	border: 1px #3a2412b0;
	border-radius: 0.25em;
	box-shadow: #000000b0 0 0.25em 1.1em 0.1em, #5a3a2070 0 0 1.4em 0.35em inset;
}

body.skin-tome #heading {
	height: 1.45em;
	line-height: 1.45em;
	margin: 0;
	font-family: "La Belle Aurore";
	font-size: 1.4em;
	text-align: center;
	color: rgb(38, 27, 17);
}

body.skin-tome #rule {
	display: block;
	flex-shrink: 0;
	height: 0.75em;
	margin: 0.1em 3em 0.35em 3em;
	decorator: image(tome/divider.png fill);
	opacity: 0.85;
}

body.skin-tome .page,
body.skin-tome.roster .page,
body.skin-tome.cards .page {
	position: relative;
	padding: 0;
}

body.skin-tome .menu {
	justify-content: flex-start;
	margin: 0;
}

body.skin-tome .row,
body.skin-tome.dense .row,
body.skin-tome.centered .row,
body.skin-tome.roster .row,
body.skin-tome.cards .row,
body.skin-tome .row.back {
	width: auto;
	min-height: 1.45em;
	height: 1.45em;
	line-height: 1.45em;
	margin: 0;
	padding: 0 0.45em;
	font-family: "La Belle Aurore";
	font-size: 0.92em;
	border: 2px transparent;
	border-radius: 0.15em;
	background-color: transparent;
	box-shadow: none;
	color: rgb(38, 27, 17);
	justify-content: flex-start;
}

body.skin-tome.dense .row {
	font-size: 0.84em;
}

/* A list of slots: ten and Back, a little closer, so the page's help stays clear under them. */
body.skin-tome.slots .row {
	min-height: 1.3em;
	height: 1.3em;
	line-height: 1.3em;
}

body.skin-tome .row .label {
	white-space: nowrap;
}

/* Back, and the plain lists of actions (a save slot's page): centred, as on the launcher. */
body.skin-tome .row.back,
body.skin-tome.centered .row,
body.skin-tome.roster .row,
body.skin-tome.cards .row {
	justify-content: center;
}

body.skin-tome .row.back {
	width: 7em;
	margin: 0 auto;
}

body.skin-tome.centered .row {
	width: 72%;
	margin: 0 auto;
}

body.skin-tome.roster .row,
body.skin-tome.cards .row {
	width: 12em;
	margin: 0 auto;
}

body.skin-tome.centered .row .leader,
body.skin-tome.roster .row .leader {
	flex: 0;
	min-width: 0.5em;
	width: 0.5em;
}

/* The chosen row: red ink inside a thin gold ring with a soft glow (the Tome's own ring round a plaque is gold). */
body.skin-tome .row.selected {
	border-width: 2px;
	color: #7a1616;
	border-color: #a8820f;
	background-color: #f0cc4a30;
	box-shadow: #ffd84ac0 0 0 0.55em 0.1em;
}

body.skin-tome .row.selected .value {
	color: #7a1616;
}

body.skin-tome .row.disabled,
body.skin-tome .row.disabled .value {
	color: #8a7a62;
}

body.skin-tome .row.selected.disabled {
	color: #6a5a4a;
}

body.skin-tome .row.chosen .label {
	color: #8e1b12;
}

body.skin-tome .leader {
	min-width: 0.6em;
}

body.skin-tome .value {
	font-family: "IM FELL English";
	font-size: 0.8em;
	line-height: 1.6em;
	color: #3a2a1a;
}

body.skin-tome.dense .value {
	font-size: 0.72em;
}

body.skin-tome.settings .value {
	min-width: 7.5em;
}

body.skin-tome .chev {
	width: 1em;
	height: 1.6em;
	line-height: 1.6em;
	font-size: 1.3em;
	color: #7a2012;
}

body.skin-tome .pick {
	min-width: 5em;
}

body.skin-tome .switch {
	width: 2.2em;
	height: 1.1em;
	border-width: 1px;
	border-radius: 0.55em;
}

body.skin-tome .knob {
	width: 0.7em;
	height: 0.7em;
	margin: 0.15em 0 0 0.15em;
	border-radius: 0.35em;
}

body.skin-tome .switch.on .knob {
	margin-left: 1.25em;
}

body.skin-tome .slider {
	width: 4.6em;
	height: 0.4em;
	border-radius: 0.2em;
}

body.skin-tome .slider-fill {
	border-radius: 0.2em;
}

body.skin-tome .slider-value {
	width: 2.6em;
}

/* No room on the leaf for a row's experimental tag: its help says it instead (frontend.cpp render). */
body.skin-tome .tag {
	display: none;
}

body.skin-tome .section {
	height: 1.2em;
	line-height: 1.2em;
	margin: 0.35em 0 0.05em 0;
	padding: 0 0 0 0.8em;
	font-family: "IM FELL English SC";
	font-size: 0.66em;
	color: #6a4a28;
}

/* A break between groups: one of the Tome's small rules. */
body.skin-tome .gap {
	height: 0.6em;
	decorator: image(tome/rule.png contain center center);
	opacity: 0.6;
}

body.skin-tome img.glyph {
	width: 1.35em;
	height: 1.35em;
	margin-left: 0.2em;
}

body.skin-tome .sep {
	width: 0.6em;
}

body.skin-tome .keycap {
	padding: 0 0.35em;
	margin-left: 0.2em;
	border-width: 1px;
	border-radius: 0.15em;
	font-size: 0.85em;
}

/* The chosen row's help at the leaf's foot, two lines at most. */
body.skin-tome .note {
	flex-shrink: 0;
	height: 2.5em;
	margin: 0.3em 0.6em 0 0.6em;
	font-size: 0.64em;
	line-height: 1.25em;
	color: #4a3018;
	text-align: center;
}

/* The directions line would cross the Tome's frame: the Tome's own pages have none either. */
body.skin-tome #hint {
	display: none;
}

/* The list's marks: the Tome's diamond above and under the rows when rows are hidden. */
body.skin-tome .list-more {
	height: 0.8em;
	margin: 0.05em 0;
}

body.skin-tome .list-more img {
	width: 0.7em;
	height: 0.7em;
}

/* Choose a character on a Tome page: the frames three to a line, three lines in view, the scroll bar beside them, and
   under them one strip for the highlighted (or chosen) one: the name, the form, the year and the meters. */
body.skin-tome.roster #heading {
	font-size: 1.15em;
}

body.skin-tome.roster #rule {
	display: none;
}

body.skin-tome.roster #pages {
	font-size: 0.87em;
}

body.skin-tome .roster-wrap {
	flex-direction: column;
	align-items: center;
}

body.skin-tome .roster-scroll {
	height: auto;
}

body.skin-tome .roster-wrap .roster {
	width: 19.2em;
	padding: 0;
}

body.skin-tome .tile {
	box-sizing: border-box;
	width: 6.1em;
	margin: 0.08em 0.12em;
	padding: 0.18em 0.15em 0.05em 0.15em;
	border-width: 2px;
	border-radius: 0.2em;
}

body.skin-tome .portrait {
	width: 4.15em;
	height: 2.93em;
	margin: 0 auto;
	border-width: 1px;
	box-shadow: #00000059 0 0.12em 0.3em 0;
}

body.skin-tome .name {
	height: 1.25em;
	line-height: 1.25em;
	margin-top: 0.1em;
	font-size: 0.6em;
}

body.skin-tome .tile-form {
	height: 1.2em;
	line-height: 1.2em;
	font-size: 0.52em;
}

body.skin-tome .tile.selected {
	color: #7a1616;
	border-color: #a8820f;
	background-color: #f0cc4a30;
	box-shadow: #ffd84ac0 0 0 0.55em 0.1em;
}

body.skin-tome .tile.chosen {
	border-color: #8e1b12b0;
	background-color: #8e1b1214;
	box-shadow: none;
}

body.skin-tome .tile.chosen.selected {
	border-color: #a8820f;
	background-color: #f0cc4a30;
	box-shadow: #ffd84ac0 0 0 0.55em 0.1em, #8e1b1260 0 0 0.25em 0.05em inset;
}

body.skin-tome .roster-bar {
	width: 0.7em;
	margin: 0 0 0 0.3em;
}

body.skin-tome .roster-cap {
	left: 0.05em;
	width: 0.6em;
	height: 0.6em;
}

body.skin-tome .roster-rail {
	top: 0.75em;
	bottom: 0.75em;
}

body.skin-tome .roster-track {
	left: 0.28em;
	width: 0.14em;
	border-radius: 0.07em;
}

body.skin-tome .roster-thumb {
	left: 0.12em;
	width: 0.46em;
	border-width: 1px;
	border-radius: 0.23em;
	box-shadow: none;
}

body.skin-tome .roster-details {
	flex: 0 0 auto;
	width: 19.6em;
	margin: 0.15em 0 0 0;
	border-width: 0;
	border-radius: 0;
	box-shadow: none;
	decorator: none;
}

.strip-rule {
	height: 0.75em;
	margin: 0 3.2em 0.1em 3.2em;
	decorator: image(tome/divider.png fill);
	opacity: 0.85;
}

.strip-line {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 1.4em;
	white-space: nowrap;
}

.strip-name {
	font-family: "La Belle Aurore";
	font-size: 0.98em;
}

.strip-form {
	margin-left: 0.7em;
	font-size: 0.72em;
	color: #7a1616;
}

.strip-year {
	margin-left: 0.7em;
	font-size: 0.68em;
	color: #5a3a20;
}

.strip-about {
	height: 1.5em;
	font-size: 0.66em;
	text-align: center;
	color: #4a3018;
}

.strip-meters {
	display: flex;
	margin: 0.1em 0.4em 0.1em 0.4em;
}

.smeter {
	display: flex;
	flex: 1;
	align-items: center;
	margin: 0 0.35em;
}

.smeter-name {
	margin-right: 0.35em;
	font-size: 0.58em;
}

.smeter .meter-bar {
	flex: 1;
	height: 0.32em;
	border-width: 1px;
	border-radius: 0.15em;
}

.smeter .meter-fill {
	border-radius: 0.15em;
}

.smeter-value {
	margin-left: 0.35em;
	font-size: 0.56em;
}

body.skin-tome.roster .gap {
	height: 0.25em;
	decorator: none;
}

/* The two players' cards (Mods > Characters on a Tome page): side by side on the leaf, every size in em. */
body.skin-tome .pcards {
	margin: 0.4em 0 0.3em 0;
}

body.skin-tome .pcard {
	width: 9.2em;
	padding: 0.45em 0.6em 0.4em 0.6em;
	border-width: 1px;
	border-radius: 0.3em;
	box-shadow: #00000070 0 0.2em 0.6em 0;
}

body.skin-tome .pcard.p1.selected,
body.skin-tome .pcard.p2.selected {
	border-width: 2px;
}

body.skin-tome .pcard.p1.selected {
	border-color: #c9a227;
	box-shadow: #e2b84a 0 0 0.8em 0.12em;
}

body.skin-tome .pcard.p2.selected {
	box-shadow: #3aa8ff 0 0 0.8em 0.12em;
}

body.skin-tome .pcard-rule {
	height: 0.6em;
}

body.skin-tome .pcard-who {
	margin: 0 0.4em;
	font-size: 0.8em;
	font-effect: none;
}

body.skin-tome .pcard-frame {
	width: 7.4em;
	height: 5.22em;
	margin: 0.35em auto 0.25em auto;
	padding: 0.22em;
	border-width: 1px;
	border-radius: 0.2em;
	box-shadow: #ffb43a90 0 0 0.5em 0.08em, #000000b0 0 0 0.3em 0.05em inset;
}

body.skin-tome .pcard.p2 .pcard-frame {
	box-shadow: #4fb4ff90 0 0 0.5em 0.08em, #000000b0 0 0 0.3em 0.05em inset;
}

body.skin-tome .pcard-portrait {
	border-width: 1px;
}

body.skin-tome .pcard-name {
	font-family: "La Belle Aurore";
	font-size: 1em;
	white-space: nowrap;
}

body.skin-tome .pcard-form {
	height: 1.2em;
	font-size: 0.66em;
}

body.skin-tome .pcard-meters {
	margin: 0.2em 0.1em 0 0.1em;
}

body.skin-tome .pcard-default {
	height: 3.6em;
	margin: 0.2em 0.3em 0 0.3em;
	font-size: 0.62em;
}

body.skin-tome .pcard-foot {
	margin-top: 0.25em;
	font-size: 0.58em;
}

body.skin-tome .pcard-press {
	height: 1.3em;
	margin-top: 0.1em;
	font-size: 0.58em;
}

body.skin-tome .pcards-mid {
	width: 1.3em;
	margin-top: 4em;
}

body.skin-tome .pcards-line {
	width: 1px;
	height: 3em;
}

body.skin-tome .pcards-mark {
	width: 0.75em;
	height: 0.75em;
	margin: 0.25em 0;
}

/* The two-card page on the leaf: the cards as Choose Character's, the pictures a little larger. */
body.skin-tome .pcard.pickcard {
	width: 9.2em;
}

body.skin-tome .pcard.pickcard .pcard-frame {
	width: 7.9em;
	height: 5.6em;
}

body.skin-tome .pcard-pair {
	width: 7.9em;
	height: 5.6em;
	margin: 0.35em auto 0.25em auto;
}

body.skin-tome .pcard.pickcard .pcard-pair .pcard-frame {
	width: 6.5em;
	height: 4.6em;
	margin: 0;
}

body.skin-tome .pcard-pair .pcard-frame.behind {
	left: 1.4em;
}

body.skin-tome .pcard-pair .pcard-frame.front {
	top: 1em;
}

body.skin-tome .pcard-frame.p2-frame {
	box-shadow: #4fb4ff90 0 0 0.5em 0.08em, #000000b0 0 0 0.3em 0.05em inset;
}

body.skin-tome.pickpage .pcards-mid {
	margin-top: 4.4em;
}

body.skin-tome .meter {
	margin: 0.12em 0;
}

body.skin-tome .meter-name {
	width: 4.6em;
	font-size: 0.6em;
}

body.skin-tome .meter-bar {
	height: 0.35em;
	border-width: 1px;
	border-radius: 0.15em;
}

body.skin-tome .meter-fill {
	border-radius: 0.15em;
}

body.skin-tome .meter-value {
	width: 2.6em;
	margin-left: 0.5em;
	font-size: 0.58em;
}

/* A co-op Tome page (body.tome-halves): the page in its owner's half, on their Tome (the renderer keeps the halves
   under it); the partner's half, paused while the page is up, under a veil (#veil, placed by frontend.cpp render). */
body.skin-tome.tome-halves #veil {
	display: block;
	position: absolute;
	z-index: -1;
	background-color: #000000a0;
}
