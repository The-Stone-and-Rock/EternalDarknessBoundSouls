<rml>
<head>
	<title>Eternal Darkness</title>
	<link type="text/rcss" href="menu.rcss"/>
</head>
<body>
	<!-- One sheet of parchment (res/ui/pause.png): the heading, the rows (Button
	     mapping in two columns), and the chosen row's help under them. -->
	<div id="book">
		<div id="heading"></div>
		<div id="pages">
			<div class="page" id="page0">
				<div class="menu" id="menu0"></div>
			</div>
			<div class="page" id="page1">
				<div class="menu" id="menu1"></div>
			</div>
		</div>
		<div class="note" id="note"></div>
	</div>
	<div id="hint"></div>
</body>
</rml>
